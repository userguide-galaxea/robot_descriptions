Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 0.1
    Plane Cell Count: 20
    Reference Frame: base_link
  - Class: rviz_default_plugins/RobotModel
    Name: LEMO Three Cameras
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Visual Enabled: true
    Collision Enabled: false
    Alpha: 1
  - Class: rviz_default_plugins/TF
    Name: Camera Frames
    Enabled: true
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Marker Scale: 0.08
    Frames:
      All Enabled: false
      base_link:
        Value: true
      L_camera_link:
        Value: true
      L_camera_optical_frame:
        Value: true
      R_camera_link:
        Value: true
      R_camera_optical_frame:
        Value: true
      head_camera_link:
        Value: true
      head_camera_optical_frame:
        Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Synthetic Test Scene
    Enabled: true
    Topic:
      Value: /lemo_camera_preview/scene
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/Image
    Name: Left Wrist Fisheye
    Enabled: true
    Topic:
      Value: /lemo_camera_preview/L/image_raw
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Normalize Range: true
  - Class: rviz_default_plugins/Image
    Name: Right Wrist Fisheye
    Enabled: true
    Topic:
      Value: /lemo_camera_preview/R/image_raw
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Normalize Range: true
  - Class: rviz_default_plugins/Image
    Name: Head Fisheye
    Enabled: true
    Topic:
      Value: /lemo_camera_preview/head/image_raw
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Normalize Range: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.9
      Focal Point:
        X: 0.2
        Y: 0
        Z: 0.3
      Pitch: 0.5
      Yaw: 0.9
      Target Frame: base_link
Window Geometry:
  Width: 1600
  Height: 1000
